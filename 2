<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>중2 과학 | 지구계 상호작용 실시간 탐험</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Pretendard Font -->
  <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
  
  <style>
    body {
      font-family: "Pretendard Variable", Pretendard, -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif;
    }
    /* 인쇄용 스타일 */
    @media print {
      .no-print { display: none !important; }
      body { background: white !important; color: black !important; }
      .print-shadow-none { box-shadow: none !important; border: 1px solid #cbd5e1 !important; }
    }
    /* 실시간 갱신 시 반짝임 애니메이션 */
    @keyframes liveGlow {
      0% { transform: scale(0.97); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      50% { transform: scale(1.02); box-shadow: 0 0 15px 4px rgba(16, 185, 129, 0.4); }
      100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }
    .cell-updated {
      animation: liveGlow 1.2s ease-out;
    }
  </style>
</head>
<body class="bg-slate-100 text-slate-900 min-h-screen antialiased selection:bg-emerald-200">

  <!-- ==================== 최상단 네비게이션 HUD ==================== -->
  <header class="no-print sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b-2 border-slate-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-3">
      
      <!-- 학급 선택 & 타이틀 -->
      <div class="flex items-center gap-3">
        <div class="bg-emerald-600 text-white font-black px-3 py-1.5 rounded-xl shadow-sm text-sm sm:text-base flex items-center gap-1.5">
          <span>🌍</span>
          <span>지구계 탐험</span>
        </div>

        <div class="relative">
          <select id="classSelect" class="bg-slate-50 border-2 border-emerald-500 font-bold text-slate-800 rounded-lg px-3 py-1.5 text-sm sm:text-base shadow-sm focus:outline-none focus:ring-2 focus:ring-emerald-400 cursor-pointer">
            <!-- JS 동적 생성 -->
          </select>
        </div>

        <button id="btnOpenClassManager" class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold px-2.5 py-1.5 rounded-lg text-xs sm:text-sm transition flex items-center gap-1">
          <span>⚙️</span>
          <span>반 관리</span>
        </button>

        <!-- 실시간 동기화 상태 뱃지 -->
        <div id="syncStatusBadge" class="hidden sm:flex items-center gap-1.5 bg-emerald-50 border border-emerald-300 text-emerald-700 px-2.5 py-1 rounded-full text-xs font-bold">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span id="syncStatusText">실시간 동기화 켜짐</span>
        </div>
      </div>

      <!-- 탐험 스톱워치 & 전체 요약 보기 -->
      <div class="flex items-center gap-2 sm:gap-3">
        <!-- 타이머 HUD -->
        <div class="flex items-center bg-slate-900 text-emerald-400 font-mono font-bold px-3 py-1.5 rounded-xl shadow border border-slate-800 text-sm sm:text-base">
          <span class="mr-1.5 text-xs text-slate-400">⏱️</span>
          <span id="mainTimerText">00:00</span>
          <button id="btnTimerToggle" title="타이머 일시정지/재개" class="ml-2 text-xs bg-slate-800 hover:bg-slate-700 text-white px-2 py-0.5 rounded transition">
            ⏸
          </button>
          <button id="btnTimerReset" title="타이머 0초로 리셋" class="ml-1 text-xs bg-slate-800 hover:bg-slate-700 text-white px-2 py-0.5 rounded transition">
            ↺
          </button>
        </div>

        <!-- 요약 및 인쇄 버튼 -->
        <button id="btnOpenReport" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-3.5 py-1.5 rounded-xl shadow text-sm transition flex items-center gap-1">
          <span>📋</span>
          <span class="hidden sm:inline">전체 요약 &</span><span>인쇄</span>
        </button>
      </div>

    </div>
  </header>

  <!-- ==================== 메인 학습 영역 ==================== -->
  <main class="max-w-7xl mx-auto px-4 py-6 space-y-6">

    <!-- 1. 단원 헤더 & 학생 안내 카드 (중2 눈높이) -->
    <section class="bg-white rounded-2xl p-5 sm:p-6 border-2 border-slate-200 shadow-md">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b-2 border-slate-100 pb-4 mb-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="bg-blue-100 text-blue-800 font-extrabold text-xs px-2.5 py-1 rounded-md">중학교 2학년 과학</span>
            <span class="bg-amber-100 text-amber-900 font-extrabold text-xs px-2.5 py-1 rounded-md">III. 지권의 변화</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-black text-slate-900 mt-1.5 tracking-tight">
            지구계 5대 구성 요소의 상호작용 매트릭스
          </h1>
        </div>

        <!-- 탐험 진행도 게이지 -->
        <div class="bg-slate-50 border-2 border-slate-200 rounded-xl p-3 min-w-[240px]">
          <div class="flex justify-between items-center text-xs font-bold text-slate-600 mb-1">
            <span>미션 달성도</span>
            <span class="text-emerald-700 font-black text-sm" id="progressText">0 / 20 칸 (0%)</span>
          </div>
          <div class="w-full bg-slate-200 h-3 rounded-full overflow-hidden">
            <div id="progressBar" class="bg-gradient-to-r from-emerald-500 to-teal-500 h-full w-0 transition-all duration-500"></div>
          </div>
        </div>
      </div>

      <!-- 탐험 3단계 규칙 카드 (가독성 극대화) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-sm">
        <div class="bg-emerald-50/80 border-2 border-emerald-200 rounded-xl p-3 flex items-start gap-2.5">
          <span class="bg-emerald-600 text-white font-black rounded-lg w-6 h-6 flex items-center justify-center shrink-0 text-xs">1</span>
          <div>
            <p class="font-extrabold text-emerald-950">가로 × 세로 권역 선택</p>
            <p class="text-emerald-800 text-xs mt-0.5 leading-snug">표에서 원하는 빈 칸을 터치/클릭하여 퀘스트를 엽니다.</p>
          </div>
        </div>

        <div class="bg-sky-50/80 border-2 border-sky-200 rounded-xl p-3 flex items-start gap-2.5">
          <span class="bg-sky-600 text-white font-black rounded-lg w-6 h-6 flex items-center justify-center shrink-0 text-xs">2</span>
          <div>
            <p class="font-extrabold text-sky-950">실제 자연현상 예시 적기</p>
            <p class="text-sky-800 text-xs mt-0.5 leading-snug">두 권역이 서로 영향을 주고받는 현상을 찾아 적습니다. (힌트 활용 가능!)</p>
          </div>
        </div>

        <div class="bg-amber-50/80 border-2 border-amber-200 rounded-xl p-3 flex items-start gap-2.5">
          <span class="bg-amber-600 text-white font-black rounded-lg w-6 h-6 flex items-center justify-center shrink-0 text-xs">3</span>
          <div>
            <p class="font-extrabold text-amber-950">실시간 실력 완성 & 제출</p>
            <p class="text-amber-800 text-xs mt-0.5 leading-snug">친구들이 적은 내용이 칠판에 실시간으로 공유됩니다!</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. 5x5 지구계 상호작용 매트릭스 표 (통일된 고대비 테마) -->
    <section class="bg-white rounded-2xl p-4 sm:p-6 border-2 border-slate-300 shadow-lg overflow-x-auto">
      <div class="min-w-[780px]">
        <table class="w-full border-collapse">
          <thead>
            <tr>
              <!-- 좌상단 코너 라벨 -->
              <th class="w-[14%] bg-slate-800 text-white font-black text-center p-3.5 rounded-tl-xl border-2 border-slate-700 text-sm sm:text-base">
                <div class="leading-tight">
                  <span class="text-emerald-300 text-xs">가로(영향) ➔</span><br>
                  <span>세로(원인) ↓</span>
                </div>
              </th>
              <!-- 가로 상단 5대 권역 헤더 (동일 디자인) -->
              <th class="w-[17.2%] bg-amber-500 text-white font-black text-center p-3.5 border-2 border-amber-600 text-lg sm:text-xl tracking-wide shadow-sm">
                지권
              </th>
              <th class="w-[17.2%] bg-blue-500 text-white font-black text-center p-3.5 border-2 border-blue-600 text-lg sm:text-xl tracking-wide shadow-sm">
                수권
              </th>
              <th class="w-[17.2%] bg-sky-500 text-white font-black text-center p-3.5 border-2 border-sky-600 text-lg sm:text-xl tracking-wide shadow-sm">
                기권
              </th>
              <th class="w-[17.2%] bg-emerald-600 text-white font-black text-center p-3.5 border-2 border-emerald-700 text-lg sm:text-xl tracking-wide shadow-sm">
                생물권
              </th>
              <th class="w-[17.2%] bg-purple-600 text-white font-black text-center p-3.5 rounded-tr-xl border-2 border-purple-700 text-lg sm:text-xl tracking-wide shadow-sm">
                외권
              </th>
            </tr>
          </thead>
          <tbody id="matrixTableBody">
            <!-- JavaScript로 5x5 셀 동적 렌더링 -->
          </tbody>
        </table>
      </div>
    </section>

  </main>

  <!-- ==================== 모달 1: 상호작용 작성 퀘스트 팝업 ==================== -->
  <div id="questModal" class="no-print fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-3xl max-w-xl w-full border-4 border-emerald-500 shadow-2xl overflow-hidden animate-in fade-in zoom-in duration-200">
      
      <!-- 팝업 헤더 -->
      <div class="bg-gradient-to-r from-emerald-600 to-teal-600 p-5 text-white flex justify-between items-center">
        <div>
          <span class="bg-white/20 text-emerald-100 text-xs font-black px-2.5 py-1 rounded-md">상호작용 퀘스트</span>
          <h2 id="modalTargetTitle" class="text-xl sm:text-2xl font-black mt-1">
            지권 ➔ 수권
          </h2>
        </div>
        <button id="btnCloseModal" class="text-white hover:text-red-200 text-2xl font-black p-1 transition">&times;</button>
      </div>

      <!-- 팝업 바디 -->
      <div class="p-6 space-y-4">
        
        <!-- 작성자 (학생/모둠 이름) 입력 -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-black text-slate-700 mb-1">✍️ 작성자 (이름 / 모둠명)</label>
            <input type="text" id="modalAuthorInput" placeholder="예: 2모둠 지우, 홍길동" class="w-full bg-slate-50 border-2 border-slate-300 focus:border-emerald-500 rounded-xl px-3 py-2 text-sm font-bold text-slate-800 focus:outline-none">
          </div>
          <div>
            <label class="block text-xs font-black text-slate-700 mb-1">⏱️ 작성 소요 시간</label>
            <div class="bg-slate-100 border-2 border-slate-200 rounded-xl px-3 py-2 text-sm font-black text-emerald-700 flex items-center justify-between">
              <span>측정 중:</span>
              <span id="modalLiveTimer">0초</span>
            </div>
          </div>
        </div>

        <!-- 상호작용 내용 작성란 -->
        <div>
          <label class="block text-xs font-black text-slate-700 mb-1">📝 상호작용 현상 설명</label>
          <textarea id="modalTextInput" rows="4" placeholder="예: 해안가에서 파도가 바위를 깎아 해식 절벽과 동굴을 만든다." class="w-full bg-slate-50 border-2 border-slate-300 focus:border-emerald-500 rounded-2xl p-3 text-base font-medium text-slate-800 focus:outline-none leading-relaxed"></textarea>
        </div>

        <!-- 힌트 상자 -->
        <div class="bg-amber-50 border-2 border-amber-200 rounded-2xl p-3.5">
          <div class="flex items-center justify-between">
            <span class="text-xs font-black text-amber-900 flex items-center gap-1">
              <span>💡</span> 교과서 핵심 힌트
            </span>
            <button id="btnToggleHint" class="text-xs bg-amber-500 hover:bg-amber-600 text-white font-bold px-2 py-1 rounded-lg transition">
              힌트 보기
            </button>
          </div>
          <p id="modalHintText" class="text-xs text-amber-950 font-semibold mt-2 hidden leading-relaxed">
            <!-- 동적 힌트 -->
          </p>
        </div>

      </div>

      <!-- 팝업 푸터 -->
      <div class="bg-slate-50 border-t-2 border-slate-100 p-4 flex justify-between items-center gap-3">
        <button id="btnDeleteCell" class="bg-rose-100 hover:bg-rose-200 text-rose-700 font-bold px-4 py-2.5 rounded-xl text-sm transition">
          지우기
        </button>
        <div class="flex gap-2">
          <button id="btnCancelModal" class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold px-4 py-2.5 rounded-xl text-sm transition">
            취소
          </button>
          <button id="btnSaveCell" class="bg-emerald-600 hover:bg-emerald-700 text-white font-black px-6 py-2.5 rounded-xl text-sm shadow-md transition">
            완료 및 실시간 저장 ✨
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- ==================== 모달 2: 학급 관리 팝업 (인라인 편집) ==================== -->
  <div id="classManagerModal" class="no-print fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-3xl max-w-lg w-full border-4 border-slate-300 shadow-2xl overflow-hidden">
      
      <div class="bg-slate-800 text-white p-5 flex justify-between items-center">
        <h2 class="text-xl font-black flex items-center gap-2">
          <span>⚙️</span> 학급 목록 관리
        </h2>
        <button id="btnCloseClassManager" class="text-white hover:text-red-200 text-2xl font-black p-1">&times;</button>
      </div>

      <div class="p-5 space-y-4 max-h-[60vh] overflow-y-auto">
        <!-- 새 학급 추가 인라인 입력창 -->
        <div class="flex gap-2">
          <input type="text" id="newClassNameInput" placeholder="새 학급 이름 (예: 2학년 9반)" class="flex-1 border-2 border-slate-300 rounded-xl px-3 py-2 text-sm font-bold">
          <button id="btnAddNewClass" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-4 py-2 rounded-xl text-sm transition">
            + 추가
          </button>
        </div>

        <!-- 학급 목록 리스트 -->
        <div id="classListContainer" class="space-y-2">
          <!-- 동적 렌더링 -->
        </div>
      </div>

      <div class="bg-slate-50 border-t-2 border-slate-100 p-4 text-right">
        <button id="btnDoneClassManager" class="bg-slate-800 hover:bg-slate-900 text-white font-bold px-5 py-2 rounded-xl text-sm">
          닫기
        </button>
      </div>

    </div>
  </div>

  <!-- ==================== 모달 3: 전체 요약 보고서 & 인쇄 뷰 ==================== -->
  <div id="reportModal" class="fixed inset-0 bg-slate-900/70 backdrop-blur-sm z-50 flex items-center justify-center p-2 sm:p-6 hidden">
    <div class="bg-white rounded-3xl max-w-4xl w-full max-h-[90vh] flex flex-col border-4 border-blue-500 shadow-2xl overflow-hidden">
      
      <!-- 보고서 헤더 -->
      <div class="bg-blue-600 text-white p-4 sm:p-5 flex justify-between items-center shrink-0">
        <div>
          <span class="bg-white/20 text-blue-100 text-xs font-black px-2.5 py-1 rounded-md">학습 포트폴리오</span>
          <h2 id="reportClassTitle" class="text-xl sm:text-2xl font-black mt-1">2학년 1반 탐험 보고서</h2>
        </div>
        <div class="flex items-center gap-2 no-print">
          <button onclick="window.print()" class="bg-white text-blue-700 hover:bg-blue-50 font-black px-3.5 py-1.5 rounded-xl text-sm transition shadow">
            🖨️ 인쇄 / PDF 저장
          </button>
          <button id="btnCloseReport" class="text-white hover:text-red-200 text-2xl font-black px-2">&times;</button>
        </div>
      </div>

      <!-- 보고서 내용 리스트 (스크롤) -->
      <div class="p-6 overflow-y-auto space-y-4 text-slate-800 flex-1" id="reportContentList">
        <!-- JS 생성 -->
      </div>

      <!-- 보고서 푸터 -->
      <div class="bg-slate-50 border-t border-slate-200 p-4 flex justify-between items-center text-xs font-bold text-slate-500 shrink-0">
        <span id="reportSummaryStats">총 0개 완성</span>
        <span>중학교 2학년 과학 지구계 탐험 활동</span>
      </div>

    </div>
  </div>

  <!-- ==================== Firebase SDK & App Logic ==================== -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
    import { getAuth, signInWithCustomToken, signInAnonymously, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
    import { getFirestore, collection, doc, setDoc, getDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

    // ----------------------------------------------------
    // 1. 교육과정 데이터 정의 (5대 권역 및 핵심 힌트)
    // ----------------------------------------------------
    const SPHERES = ["지권", "수권", "기권", "생물권", "외권"];
    
    // 가로 및 세로 헤더에 동일하게 적용되는 선명한 고대비 컬러 스타일
    const SPHERE_COLORS = {
      "지권": "bg-amber-500 text-white border-amber-600",
      "수권": "bg-blue-500 text-white border-blue-600",
      "기권": "bg-sky-500 text-white border-sky-600",
      "생물권": "bg-emerald-600 text-white border-emerald-700",
      "외권": "bg-purple-600 text-white border-purple-700",
    };

    const HINTS = {
      "0_1": "화산 폭발로 분출된 화산재나 마그마가 바다로 흘러들어 바닷물의 성분이 변하거나 해저 화산섬(독도, 하와이 등)이 형성됩니다.",
      "0_2": "화산 분출 시 많은 양의 화산가스와 화산재가 대기로 공급되어 기후 변화를 일으킵니다. 또 지표면의 먼지가 바람에 날립니다(황사).",
      "0_3": "토양(흙)은 식물이 뿌리를 내리고 자라며 다양한 생물들이 살아가는 서식처와 무기 양분을 제공합니다.",
      "0_4": "지구 자기장이 우주에서 날아오는 해로운 우주 방사선(태양풍)을 막아줍니다.",
      
      "1_0": "파도나 흐르는 물(강물)이 바위를 깎아 해식 절벽, V자곡을 만들고, 지하수가 석회암을 녹여 석회동굴을 만듭니다.",
      "1_2": "바다나 강에서 증발한 수증기가 하늘로 올라가 구름이 되고 비나 눈이 내리는 기상 현상을 일으킵니다.",
