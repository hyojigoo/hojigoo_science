      "3_1": "육지 식물이 뿌리로 땅속 물을 흡수한 뒤 잎의 증산작용을 통해 수분을 공기 중과 강으로 되돌려 보냅니다.",
      "3_2": "식물의 광합성으로 산소가 대기에 공급되고, 동물과 사람의 호흡으로 이산화 탄소가 배출되어 공기 조성이 유지됩니다.",
      "3_4": "우주 탐사선에 탑승한 우주비행사나 미생물이 외계 우주 환경을 탐사하고 연구합니다.",

      "4_0": "우주에서 날아온 운석이 지구 지표면에 강하게 충돌하여 거대한 운석 구덩이(크레이터)를 만듭니다.",
      "4_1": "달과 태양의 인력(외권의 중력)으로 인해 하루 두 번 바닷물이 들고 나는 밀물과 썰물(조석 현상)이 발생합니다.",
      "4_2": "태양에서 방출된 고에너지 입자가 지구 대기의 기체 입자와 충돌하여 화려한 빛을 내는 '오로라'가 발생합니다.",
      "4_3": "태양에서 오는 빛에너지는 지구 생물이 살아가고 식물이 광합성을 하는 가장 근본적인 에너지원입니다."
    };

    // ----------------------------------------------------
    // 2. 상태 관리 (State)
    // ----------------------------------------------------
    let classes = [
      { id: "c1", name: "2학년 1반" },
      { id: "c2", name: "2학년 2반" },
      { id: "c3", name: "2학년 3반" },
      { id: "c4", name: "2학년 4반" },
      { id: "c5", name: "2학년 5반" },
      { id: "c6", name: "2학년 6반" },
      { id: "c7", name: "2학년 7반" },
      { id: "c8", name: "2학년 8반" },
    ];
    let currentClassId = "c1";
    let matrixData = {}; // key: "r_c" -> { text, author, time, updatedAt }

    // 타이머 상태
    let globalSeconds = 0;
    let timerRunning = true;
    let mainTimerInterval = null;

    let activeCellKey = null;
    let cellStartTime = 0;
    let cellTimerInterval = null;

    // Firebase & Firestore 참조
    let db = null;
    let auth = null;
    let currentUser = null;
    const appId = typeof __app_id !== 'undefined' ? __app_id : 'earth-matrix-sync';

    // ----------------------------------------------------
    // 3. 초기화 & Firebase 연결
    // ----------------------------------------------------
    async function initApp() {
      // 1) UI 기초 렌더링
      renderClassSelect();
      renderMatrixGrid();
      startMainTimer();

      // 2) Firebase 설정 검사 및 연동
      if (typeof __firebase_config !== 'undefined') {
        try {
          const config = JSON.parse(__firebase_config);
          const app = initializeApp(config);
          auth = getAuth(app);
          db = getFirestore(app);

          // 인증 수행
          if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
            await signInWithCustomToken(auth, __initial_auth_token);
          } else {
            await signInAnonymously(auth);
          }

          onAuthStateChanged(auth, (user) => {
            currentUser = user;
            if (user) {
              document.getElementById("syncStatusBadge").classList.remove("hidden");
              subscribeRealtimeData();
            }
          });
        } catch (e) {
          console.warn("Firestore fallback active:", e);
        }
      } else {
        // standalone 데모 모드 (로컬 채널 연동)
        setupLocalSync();
      }

      setupEventListeners();
    }

    // ----------------------------------------------------
    // 4. 실시간 동기화 (Firestore / Local fallback)
    // ----------------------------------------------------
    let unsubscribeFirestore = null;

    function subscribeRealtimeData() {
      if (!db || !currentUser) return;
      if (unsubscribeFirestore) unsubscribeFirestore();

      // 엄격 규칙 적용: /artifacts/{appId}/public/data/class_matrices
      const classDocRef = doc(db, 'artifacts', appId, 'public', 'data', `class_${currentClassId}`);
      
      unsubscribeFirestore = onSnapshot(classDocRef, (snap) => {
        if (snap.exists()) {
          const data = snap.data();
          if (data && data.cells) {
            matrixData = data.cells;
            updateMatrixUI();
          }
        } else {
          matrixData = {};
          updateMatrixUI();
        }
      }, (err) => {
        console.error("Firestore snapshot error:", err);
      });
    }

    async function saveCurrentMatrixToCloud(updatedKey) {
      if (db && currentUser) {
        try {
          const classDocRef = doc(db, 'artifacts', appId, 'public', 'data', `class_${currentClassId}`);
          await setDoc(classDocRef, {
            classId: currentClassId,
            cells: matrixData,
            lastUpdated: Date.now()
          }, { merge: true });
        } catch (e) {
          console.error("Save error:", e);
        }
      } else {
        // Local Broadcast Channel로 탭 간 실시간 공유
        if (window.BroadcastChannel) {
          const channel = new BroadcastChannel('earth_science_sync');
          channel.postMessage({ classId: currentClassId, cells: matrixData, updatedKey });
        }
      }
    }

    function setupLocalSync() {
      if (window.BroadcastChannel) {
        const channel = new BroadcastChannel('earth_science_sync');
        channel.onmessage = (event) => {
          if (event.data && event.data.classId === currentClassId) {
            matrixData = event.data.cells || {};
            updateMatrixUI(event.data.updatedKey);
          }
        };
      }
    }

    // ----------------------------------------------------
    // 5. 표(Matrix) 렌더링 & UI 업데이트
    // ----------------------------------------------------
    function renderMatrixGrid() {
      const tbody = document.getElementById("matrixTableBody");
      tbody.innerHTML = "";

      for (let r = 0; r < 5; r++) {
        const tr = document.createElement("tr");

        // 행 헤더 (세로 권역 - 가로 헤더와 100% 동일한 디자인 스타일 적용)
        const rowHeader = document.createElement("th");
        rowHeader.className = `p-3.5 font-black text-center text-lg sm:text-xl border-2 tracking-wide shadow-sm ${SPHERE_COLORS[SPHERES[r]]}`;
        rowHeader.innerText = SPHERES[r];
        tr.appendChild(rowHeader);

        // 5개 열 셀
        for (let c = 0; c < 5; c++) {
          const td = document.createElement("td");
          const key = `${r}_${c}`;
          td.id = `cell-${key}`;

          if (r === c) {
            // 대각선: 같은 권역끼리는 비활성화
            td.className = "p-3 border-2 border-slate-200 bg-slate-200/70 text-slate-400 text-center font-bold min-h-[110px] select-none";
            td.innerHTML = `
              <div class="flex flex-col items-center justify-center py-6 text-slate-400">
                <span class="text-xl">🔒</span>
                <span class="text-xs mt-1 font-bold">동일 권역</span>
              </div>
            `;
          } else {
            // 활성 인터랙티브 셀
            td.className = "p-2.5 border-2 border-slate-200 bg-white hover:bg-slate-50 transition-all cursor-pointer min-h-[115px] align-top relative group";
            td.onclick = () => openQuestModal(r, c);
            td.innerHTML = getCellHTML(key);
          }
          tr.appendChild(td);
        }
        tbody.appendChild(tr);
      }

      updateProgress();
    }

    function getCellHTML(key) {
      const item = matrixData[key];
      if (item && item.text && item.text.trim().length > 0) {
        return `
          <div class="h-full flex flex-col justify-between p-2.5 rounded-xl bg-emerald-50/90 border-2 border-emerald-400 text-slate-900 shadow-sm">
            <p class="text-xs sm:text-sm font-semibold leading-relaxed line-clamp-3">${escapeHtml(item.text)}</p>
            <div class="flex items-center justify-between mt-2 pt-1.5 border-t border-emerald-200 text-[11px] font-bold text-emerald-800">
              <span class="truncate max-w-[90px]">✍️ ${escapeHtml(item.author || "학생")}</span>
              <span class="text-emerald-700 font-mono">⏱️ ${item.time || 0}초</span>
            </div>
          </div>
        `;
      } else {
        return `
          <div class="h-full min-h-[90px] flex flex-col items-center justify-center text-center p-2 rounded-xl border-2 border-dashed border-slate-200 group-hover:border-emerald-400 group-hover:bg-emerald-50/40 transition">
            <span class="text-slate-300 group-hover:text-emerald-500 font-black text-xl mb-0.5">+</span>
            <span class="text-xs font-bold text-slate-400 group-hover:text-emerald-700">작성하기</span>
          </div>
        `;
      }
    }

    function updateMatrixUI(glowKey = null) {
      for (let r = 0; r < 5; r++) {
        for (let c = 0; c < 5; c++) {
          if (r === c) continue;
          const key = `${r}_${c}`;
          const td = document.getElementById(`cell-${key}`);
          if (td) {
            td.innerHTML = getCellHTML(key);
            if (glowKey && glowKey === key) {
              td.classList.add("cell-updated");
              setTimeout(() => td.classList.remove("cell-updated"), 1300);
            }
          }
        }
      }
      updateProgress();
    }

    function updateProgress() {
      let count = 0;
      for (let r = 0; r < 5; r++) {
        for (let c = 0; c < 5; c++) {
          if (r === c) continue;
          const key = `${r}_${c}`;
          if (matrixData[key] && matrixData[key].text && matrixData[key].text.trim().length > 0) {
            count++;
          }
        }
      }
      const pct = Math.round((count / 20) * 100);
      document.getElementById("progressText").innerText = `${count} / 20 칸 (${pct}%)`;
      document.getElementById("progressBar").style.width = `${pct}%`;
    }

    // ----------------------------------------------------
    // 6. 퀘스트 팝업 & 타이머
    // ----------------------------------------------------
    function openQuestModal(r, c) {
      activeCellKey = `${r}_${c}`;
      const originSphere = SPHERES[r];
      const targetSphere = SPHERES[c];

      document.getElementById("modalTargetTitle").innerText = `${originSphere} ➔ ${targetSphere}`;
      
      const existing = matrixData[activeCellKey] || { text: "", author: "", time: 0 };
      document.getElementById("modalTextInput").value = existing.text || "";
      document.getElementById("modalAuthorInput").value = existing.author || "";

      // 힌트 초기화
      const hint = HINTS[activeCellKey] || "두 권역 사이에서 일어나는 변화와 현상을 교과서나 자연에서 찾아 적어보세요!";
      document.getElementById("modalHintText").innerText = hint;
      document.getElementById("modalHintText").classList.add("hidden");
      document.getElementById("btnToggleHint").innerText = "힌트 보기";

      // 개별 셀 측정 타이머 시작
      cellStartTime = Date.now();
      let currentElapsed = existing.time || 0;
      document.getElementById("modalLiveTimer").innerText = `${currentElapsed}초`;
      
      if (cellTimerInterval) clearInterval(cellTimerInterval);
      cellTimerInterval = setInterval(() => {
        currentElapsed++;
        document.getElementById("modalLiveTimer").innerText = `${currentElapsed}초`;
      }, 1000);

      document.getElementById("questModal").classList.remove("hidden");
      document.getElementById("modalTextInput").focus();
    }

    function closeQuestModal() {
      if (cellTimerInterval) clearInterval(cellTimerInterval);
      document.getElementById("questModal").classList.add("hidden");
      activeCellKey = null;
    }

    function saveCellData() {
      if (!activeCellKey) return;
      const text = document.getElementById("modalTextInput").value.trim();
      const author = document.getElementById("modalAuthorInput").value.trim() || "학생";
      
      const elapsed = parseInt(document.getElementById("modalLiveTimer").innerText) || 0;

      if (text.length === 0) {
        delete matrixData[activeCellKey];
      } else {
        matrixData[activeCellKey] = {
          text: text,
          author: author,
          time: elapsed,
          updatedAt: Date.now()
        };
      }

      const updated = activeCellKey;
      closeQuestModal();
      updateMatrixUI(updated);
      saveCurrentMatrixToCloud(updated);
    }

    function deleteCellData() {
      if (!activeCellKey) return;
      delete matrixData[activeCellKey];
      const updated = activeCellKey;
      closeQuestModal();
      updateMatrixUI(updated);
      saveCurrentMatrixToCloud(updated);
    }

    // ----------------------------------------------------
    // 7. 학급 관리 (생성, 수정, 삭제)
    // ----------------------------------------------------
    function renderClassSelect() {
      const select = document.getElementById("classSelect");
      select.innerHTML = "";
      classes.forEach(cls => {
        const opt = document.createElement("option");
        opt.value = cls.id;
        opt.innerText = cls.name;
        if (cls.id === currentClassId) opt.selected = true;
        select.appendChild(opt);
      });
    }

    function renderClassManagerList() {
      const container = document.getElementById("classListContainer");
      container.innerHTML = "";

      classes.forEach(cls => {
        const div = document.createElement("div");
        div.className = "flex items-center justify-between p-3 bg-slate-50 border-2 border-slate-200 rounded-xl";
        div.id = `class-row-${cls.id}`;

        div.innerHTML = `
          <span class="font-bold text-slate-800 text-sm" id="class-name-label-${cls.id}">${escapeHtml(cls.name)}</span>
          <div class="flex items-center gap-1.5" id="class-actions-${cls.id}">
            <button onclick="startEditClass('${cls.id}')" class="bg-slate-200 hover:bg-slate-300 text-slate-700 px-2.5 py-1 rounded-lg text-xs font-bold transition">
              수정
            </button>
            <button onclick="startDeleteClass('${cls.id}')" class="bg-rose-100 hover:bg-rose-200 text-rose-700 px-2.5 py-1 rounded-lg text-xs font-bold transition">
              삭제
            </button>
          </div>
        `;
        container.appendChild(div);
      });
    }

    window.startEditClass = (id) => {
      const target = classes.find(c => c.id === id);
      if (!target) return;
      const row = document.getElementById(`class-row-${id}`);
      row.innerHTML = `
        <input type="text" id="input-edit-${id}" value="${escapeHtml(target.name)}" class="border-2 border-emerald-500 rounded-lg px-2.5 py-1 text-sm font-bold flex-1 mr-2">
        <button onclick="saveEditClass('${id}')" class="bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1 rounded-lg text-xs font-bold mr-1">저장</button>
        <button onclick="renderClassManagerList()" class="bg-slate-200 text-slate-700 px-2.5 py-1 rounded-lg text-xs font-bold">취소</button>
      `;
    };

    window.saveEditClass = (id) => {
      const input = document.getElementById(`input-edit-${id}`);
      if (!input) return;
      const val = input.value.trim();
      if (val) {
        const target = classes.find(c => c.id === id);
        if (target) target.name = val;
        renderClassSelect();
        renderClassManagerList();
      }
    };

    window.startDeleteClass = (id) => {
      if (classes.length <= 1) {
        alert("최소 1개 이상의 학급은 유지되어야 합니다.");
        return;
      }
      const target = classes.find(c => c.id === id);
      const row = document.getElementById(`class-row-${id}`);
      row.innerHTML = `
        <span class="text-xs font-bold text-rose-700 mr-2">'${escapeHtml(target.name)}' 삭제할까요?</span>
        <button onclick="confirmDeleteClass('${id}')" class="bg-rose-600 text-white px-3 py-1 rounded-lg text-xs font-bold mr-1">삭제</button>
        <button onclick="renderClassManagerList()" class="bg-slate-200 text-slate-700 px-2.5 py-1 rounded-lg text-xs font-bold">취소</button>
      `;
    };

    window.confirmDeleteClass = (id) => {
      classes = classes.filter(c => c.id !== id);
      if (currentClassId === id) {
        currentClassId = classes[0].id;
      }
      renderClassSelect();
      renderClassManagerList();
      subscribeRealtimeData();
    };

    // ----------------------------------------------------
    // 8. 전체 요약 보고서 & 인쇄 기능
    // ----------------------------------------------------
    function openReportModal() {
      const currentClass = classes.find(c => c.id === currentClassId);
      document.getElementById("reportClassTitle").innerText = `${currentClass ? currentClass.name : '학급'} 상호작용 종합 보고서`;

      const list = document.getElementById("reportContentList");
      list.innerHTML = "";

      let filledCount = 0;
      let totalSeconds = 0;

      for (let r = 0; r < 5; r++) {
        for (let c = 0; c < 5; c++) {
          if (r === c) continue;
          const key = `${r}_${c}`;
          const item = matrixData[key];
          
          const card = document.createElement("div");
          card.className = "p-3.5 rounded-xl border-2 print-shadow-none flex flex-col sm:flex-row sm:items-center justify-between gap-3 ";

          if (item && item.text && item.text.trim().length > 0) {
            filledCount++;
            totalSeconds += (item.time || 0);
            card.className += "bg-emerald-50/70 border-emerald-300";
            card.innerHTML = `
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="bg-emerald-700 text-white font-black text-xs px-2 py-0.5 rounded">
                    ${SPHERES[r]} ➔ ${SPHERES[c]}
                  </span>
                  <span class="text-xs font-bold text-slate-500">작성자: ${escapeHtml(item.author || "학생")}</span>
                </div>
                <p class="font-bold text-slate-900 text-sm leading-relaxed">${escapeHtml(item.text)}</p>
              </div>
              <div class="shrink-0 text-xs font-mono font-bold text-emerald-800 bg-white px-3 py-1 rounded-lg border border-emerald-200">
                ⏱️ ${item.time || 0}초
              </div>
            `;
          } else {
            card.className += "bg-slate-50 border-slate-200 opacity-60";
            card.innerHTML = `
              <div class="flex items-center gap-2">
                <span class="bg-slate-400 text-white font-black text-xs px-2 py-0.5 rounded">
                  ${SPHERES[r]} ➔ ${SPHERES[c]}
                </span>
                <span class="text-xs font-medium text-slate-400">아직 작성되지 않은 상호작용입니다.</span>
              </div>
            `;
          }
          list.appendChild(card);
        }
      }

      document.getElementById("reportSummaryStats").innerText = `완성: ${filledCount} / 20 개 | 총 소요시간 합계: ${totalSeconds}초`;
      document.getElementById("reportModal").classList.remove("hidden");
    }

    // ----------------------------------------------------
    // 9. 메인 타이머 스톱워치
    // ----------------------------------------------------
    function startMainTimer() {
      if (mainTimerInterval) clearInterval(mainTimerInterval);
      mainTimerInterval = setInterval(() => {
        if (timerRunning) {
          globalSeconds++;
          const min = String(Math.floor(globalSeconds / 60)).padStart(2, '0');
          const sec = String(globalSeconds % 60).padStart(2, '0');
          document.getElementById("mainTimerText").innerText = `${min}:${sec}`;
        }
      }, 1000);
    }

    // ----------------------------------------------------
    // 10. 이벤트 리스너 바인딩
    // ----------------------------------------------------
    function setupEventListeners() {
      // 학급 변경
      document.getElementById("classSelect").addEventListener("change", (e) => {
        currentClassId = e.target.value;
        subscribeRealtimeData();
      });

      // 타이머 토글 & 리셋
      document.getElementById("btnTimerToggle").addEventListener("click", () => {
        timerRunning = !timerRunning;
        document.getElementById("btnTimerToggle").innerText = timerRunning ? "⏸" : "▶";
      });

      document.getElementById("btnTimerReset").addEventListener("click", () => {
        globalSeconds = 0;
        document.getElementById("mainTimerText").innerText = "00:00";
      });

      // 퀘스트 모달 버튼
      document.getElementById("btnCloseModal").addEventListener("click", closeQuestModal);
      document.getElementById("btnCancelModal").addEventListener("click", closeQuestModal);
      document.getElementById("btnSaveCell").addEventListener("click", saveCellData);
      document.getElementById("btnDeleteCell").addEventListener("click", deleteCellData);

      // 힌트 토글
      document.getElementById("btnToggleHint").addEventListener("click", () => {
        const hintEl = document.getElementById("modalHintText");
        const isHidden = hintEl.classList.contains("hidden");
        if (isHidden) {
          hintEl.classList.remove("hidden");
          document.getElementById("btnToggleHint").innerText = "힌트 숨기기";
        } else {
          hintEl.classList.add("hidden");
          document.getElementById("btnToggleHint").innerText = "힌트 보기";
        }
      });

      // 학급 관리 모달
      document.getElementById("btnOpenClassManager").addEventListener("click", () => {
        renderClassManagerList();
        document.getElementById("classManagerModal").classList.remove("hidden");
      });
      document.getElementById("btnCloseClassManager").addEventListener("click", () => {
        document.getElementById("classManagerModal").classList.add("hidden");
      });
      document.getElementById("btnDoneClassManager").addEventListener("click", () => {
        document.getElementById("classManagerModal").classList.add("hidden");
      });

      document.getElementById("btnAddNewClass").addEventListener("click", () => {
        const input = document.getElementById("newClassNameInput");
        const val = input.value.trim();
        if (val) {
          const newId = `c_${Date.now()}`;
          classes.push({ id: newId, name: val });
          input.value = "";
          renderClassSelect();
          renderClassManagerList();
        }
      });

      // 요약 모달
      document.getElementById("btnOpenReport").addEventListener("click", openReportModal);
      document.getElementById("btnCloseReport").addEventListener("click", () => {
        document.getElementById("reportModal").classList.add("hidden");
      });
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    // 앱 실행
    window.addEventListener("DOMContentLoaded", initApp);
  </script>
</body>
</html>
